cmake_minimum_required(VERSION 3.25)

foreach(required_variable MANNY_DLL_FILE MANNY_NOTICES_FILE)
    if(NOT DEFINED ${required_variable} OR NOT EXISTS "${${required_variable}}")
        message(FATAL_ERROR "${required_variable} must name an existing file")
    endif()
endforeach()
file(SIZE "${MANNY_DLL_FILE}" dll_size)
file(SIZE "${MANNY_NOTICES_FILE}" notices_size)
if(dll_size GREATER 33554432 OR notices_size LESS 1 OR notices_size GREATER 262144)
    message(FATAL_ERROR "DLL or third-party notices exceed their verification bounds")
endif()
file(READ "${MANNY_DLL_FILE}" dll_bytes HEX)
file(READ "${MANNY_NOTICES_FILE}" notices_bytes HEX)
set(skipped 0)
set(found FALSE)
while(NOT found)
    string(FIND "${dll_bytes}" "${notices_bytes}" notices_offset)
    if(notices_offset EQUAL -1)
        break()
    endif()
    math(EXPR alignment "(${skipped} + ${notices_offset}) % 2")
    if(alignment EQUAL 0)
        set(found TRUE)
    else()
        math(EXPR advance "${notices_offset} + 1")
        math(EXPR skipped "${skipped} + ${advance}")
        string(SUBSTRING "${dll_bytes}" ${advance} -1 dll_bytes)
    endif()
endwhile()
if(NOT found)
    message(FATAL_ERROR "DLL does not contain the complete current third-party notices")
endif()
message(STATUS "Verified embedded third-party notices (${notices_size} bytes)")
