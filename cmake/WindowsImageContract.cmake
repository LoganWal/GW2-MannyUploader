function(manny_verify_windows_image headers exports dependencies)
    if(NOT headers MATCHES "8664 machine \\(x64\\)" OR NOT headers MATCHES "File Type: DLL")
        message(FATAL_ERROR "Nexus image must be a Windows x64 DLL")
    endif()
    if(NOT headers MATCHES "Format: RSDS, [^\r\n]+manny_uploader\\.pdb")
        message(FATAL_ERROR "Nexus DLL must reference its linker PDB")
    endif()
    if(NOT exports MATCHES "[\r\n][ \t]+1 number of functions[\r\n]"
       OR NOT exports MATCHES "[\r\n][ \t]+1 number of names[\r\n]")
        message(FATAL_ERROR "Nexus DLL must have exactly one named export")
    endif()

    string(REPLACE "\n" ";" export_lines "${exports}")
    set(export_names "")
    foreach(line IN LISTS export_lines)
        if(line MATCHES "^[ \t]*[0-9]+[ \t]+[0-9A-Fa-f]+[ \t]+[0-9A-Fa-f]+[ \t]+([^ \t\r=]+)")
            list(APPEND export_names "${CMAKE_MATCH_1}")
        endif()
    endforeach()
    if(NOT export_names STREQUAL "GetAddonDef")
        message(FATAL_ERROR "Nexus DLL must export only GetAddonDef")
    endif()

    # Shipping one DLL requires every import to be supplied by Windows.
    set(system_libraries kernel32 shell32 ws2_32 crypt32 secur32 bcrypt advapi32 normaliz
        iphlpapi bcryptprimitives ntdll user32 gdi32 ole32 oleaut32 uuid version)
    string(REPLACE "\n" ";" dependency_lines "${dependencies}")
    set(dependency_count 0)
    foreach(line IN LISTS dependency_lines)
        string(TOLOWER "${line}" line)
        if(line MATCHES "^[ \t]+([^ \t\r]+)\\.dll[ \t\r]*$")
            set(library "${CMAKE_MATCH_1}")
            if(NOT library IN_LIST system_libraries AND NOT library MATCHES "^api-ms-win-[a-z0-9-]+$")
                message(FATAL_ERROR "Nexus DLL imports a non-system dependency: ${library}.dll")
            endif()
            math(EXPR dependency_count "${dependency_count} + 1")
        endif()
    endforeach()
    if(dependency_count EQUAL 0)
        message(FATAL_ERROR "Nexus DLL dependency listing is empty")
    endif()
endfunction()
