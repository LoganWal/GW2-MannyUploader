cmake_minimum_required(VERSION 3.25)
include("${CMAKE_CURRENT_LIST_DIR}/../../cmake/WindowsImageContract.cmake")

if(DEFINED MANNY_CASE)
    set(headers "File Type: DLL\n 8664 machine (x64)\n Format: RSDS, {00000000-0000-0000-0000-000000000000}, 1, manny_uploader.pdb\n")
    set(exports "\n 1 number of functions\n 1 number of names\n ordinal hint RVA name\n 1 0 000231D0 GetAddonDef = GetAddonDef\n")
    set(dependencies "    KERNEL32.dll\n    api-ms-win-core-synch-l1-2-0.dll\n    CRYPT32.dll\n")
    if(MANNY_CASE STREQUAL "x86")
        string(REPLACE "8664 machine (x64)" "14C machine (x86)" headers "${headers}")
    elseif(MANNY_CASE STREQUAL "executable")
        string(REPLACE "File Type: DLL" "File Type: EXECUTABLE IMAGE" headers "${headers}")
    elseif(MANNY_CASE STREQUAL "no-symbols")
        set(headers "File Type: DLL\n 8664 machine (x64)\n")
    elseif(MANNY_CASE STREQUAL "missing-export")
        set(exports "")
    elseif(MANNY_CASE STREQUAL "wrong-export")
        string(REPLACE "GetAddonDef" "OtherExport" exports "${exports}")
    elseif(MANNY_CASE STREQUAL "test-export")
        string(APPEND exports " 2 A 00023200 MannyLifecycleTestState\n")
    elseif(MANNY_CASE STREQUAL "ordinal-export")
        string(REPLACE "1 number of functions" "2 number of functions" exports "${exports}")
        string(APPEND exports " 2   00023200 [NONAME]\n")
    elseif(MANNY_CASE STREQUAL "dynamic-crt")
        string(APPEND dependencies "    VCRUNTIME140.dll\n")
    elseif(MANNY_CASE STREQUAL "dynamic-curl")
        string(APPEND dependencies "    libcurl.dll\n")
    elseif(MANNY_CASE STREQUAL "no-dependencies")
        set(dependencies "")
    endif()
    manny_verify_windows_image("${headers}" "${exports}" "${dependencies}")
    return()
endif()

foreach(case valid x86 executable no-symbols missing-export wrong-export test-export ordinal-export
        dynamic-crt dynamic-curl no-dependencies)
    execute_process(COMMAND "${CMAKE_COMMAND}" "-DMANNY_CASE=${case}" -P "${CMAKE_CURRENT_LIST_FILE}"
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
    if(case STREQUAL "valid")
        if(NOT result EQUAL 0)
            message(FATAL_ERROR "Valid Windows image rejected: ${output}${error}")
        endif()
    elseif(result EQUAL 0)
        message(FATAL_ERROR "Invalid Windows image accepted: ${case}")
    endif()
endforeach()
message(STATUS "Verified Windows image contract cases")
